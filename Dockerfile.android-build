# Android Termux 构建 Dockerfile
# 使用方法: docker build -f Dockerfile.termux -t openfang-termux .

FROM ghcr.io/cross-rs/aarch64-linux-android:main

ENV ANDROID_API=21
ENV ANDROID_API_aarch64_linux_android=21
ENV RUSTFLAGS="-C link-arg=-Wl,--hash-style=both"
ENV HOME=/root

# 安装依赖
RUN apt-get update && apt-get install -y \
    curl \
    git \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# 安装 Rust 并添加 target
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable \
    && . /root/.cargo/env \
    && rustup target add aarch64-linux-android

WORKDIR /app

# 复制源码
COPY . .

# 编译
RUN . /root/.cargo/env \
    && RUSTFLAGS="-C link-arg=-Wl,--hash-style=both" cargo build --release --target aarch64-linux-android -p openfang-cli

# 打包输出
FROM alpine:latest
WORKDIR /output
COPY --from=0 /app/target/aarch64-linux-android/release/openfang /output/
