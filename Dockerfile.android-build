# Multi-stage Dockerfile for Android aarch64 build
# This file compiles OpenFang for Android aarch64 and allows extracting the binary

# Stage 1: Build stage
FROM ghcr.io/cross-rs/aarch64-linux-android:main AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /project

# Copy the project files
COPY . .

# Build the project for aarch64-linux-android
# Build CLI binary
RUN cargo build --target aarch64-linux-android --release --bin openfang

# Note: openfang-desktop requires GUI libraries not available in Android environment
# For Android, we only build the CLI binary
# RUN cargo build --target aarch64-linux-android --release --bin openfang-desktop

# Stage 2: Export stage - creates a minimal image with just the binaries
FROM scratch AS export

# Copy binaries from builder stage
COPY --from=builder /project/target/aarch64-linux-android/release/openfang /openfang

# The scratch stage is used for extraction, not for running

# Stage 3: Final image with utilities for easy binary extraction
FROM alpine:3.20 AS final

# Install required tools
RUN apk add --no-cache \
    ca-certificates \
    tzdata \
    file

# Copy binaries from builder stage
COPY --from=builder /project/target/aarch64-linux-android/release/openfang /usr/local/bin/openfang

# Make binary executable
RUN chmod +x /usr/local/bin/openfang

# Set working directory
WORKDIR /output

# Default command - show binary info
CMD ["file", "/usr/local/bin/openfang"]

# Metadata
LABEL maintainer="myg133"
LABEL description="OpenFang Android aarch64 build with extraction utilities"
LABEL version="0.3.46"