# 使用阿里云镜像加速
FROM registry.cn-hangzhou.aliyuncs.com/androidndk/android-ndk-r25b

# 安装 Rust
RUN wget -q https://static.rust-lang.org/rustup/dist/aarch64-linux-android/rustup-init && \
    chmod +x rustup-init && \
    ./rustup-init -y --default-toolchain stable && \
    rm rustup-init

ENV PATH="/root/.cargo/bin:${PATH}"

# 添加 Android 目标
RUN rustup target add aarch64-linux-android

WORKDIR /workspace

# 复制源码
COPY . .

# 构建
RUN cargo build --target aarch64-linux-android --release -p openfang-cli

# 最终镜像
FROM debian:stable-slim
COPY --from=0 /workspace/target/aarch64-linux-android/release/openfang /openfang

ENTRYPOINT ["sh"]